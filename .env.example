# ============================================================
# AI HOSPITAL CAMERA - ENVIRONMENT CONFIGURATION
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# Application
APP_NAME=AI Hospital Camera
APP_VERSION=1.0.0
DEBUG=false
DEMO_MODE=true

# Security - GENERATE NEW VALUES for each deployment
SECRET_KEY=CHANGE_ME_use_secrets_token_urlsafe_32
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=ai_hospital_camera
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_strong_password

# AI Engine
AI_ENABLED=true
AI_BACKEND=cpu
AI_MODEL_PATH=./models
AI_MAX_CONCURRENT_STREAMS=10
AI_INFERENCE_FPS=2.0

# Video Gateway (MediaMTX)
MEDIAMTX_API_URL=http://localhost:9997
MEDIAMTX_RTSP_PORT=8554

# Evidence storage (use absolute path in production)
EVIDENCE_STORAGE_PATH=./evidence_storage
EVIDENCE_MAX_SIZE_GB=50.0

# CORS - add your frontend URL
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# Camera network allowlist (CIDR) - restrict to your camera network
CAMERA_ALLOWED_SUBNETS=["192.168.1.0/24"]

# Redis (optional - for token blacklist and caching)
# REDIS_URL=redis://localhost:6379/0
